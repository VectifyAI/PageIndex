              "end_index": 9,
              "node_id": "0012",
              "summary": "\u8be5\u90e8\u5206\u6587\u6863\u662f\u7267\u539f\u98df\u54c1\u80a1\u4efd\u6709\u9650\u516c\u53f82025\u5e74\u7b2c\u4e09\u5b63\u5ea6\u62a5\u544a\u4e2d\u5408\u5e76\u5229\u6da6\u8868\u53ca\u5408\u5e76\u73b0\u91d1\u6d41\u91cf\u8868\u7684\u8d77\u59cb\u90e8\u5206\u3002\u4e3b\u8981\u6db5\u76d6\u4ee5\u4e0b\u5185\u5bb9\uff1a\n\n1.  **\u5408\u5e76\u5229\u6da6\u8868\uff08\u5e74\u521d\u81f3\u62a5\u544a\u671f\u672b\uff09**\uff1a\u8be6\u7ec6\u5217\u793a\u4e86\u516c\u53f8\u4ece\u5e74\u521d\u52302025\u5e74\u7b2c\u4e09\u5b63\u5ea6\u672b\u7684\u5404\u9879\u8d22\u52a1\u6570\u636e\uff0c\u5305\u62ec\uff1a\n    *   **\u8425\u4e1a\u603b\u6536\u5165**\u53ca\u6784\u6210\uff08\u4e3b\u8981\u4e3a\u8425\u4e1a\u6536\u5165\uff09\u3002\n    *   **\u8425\u4e1a\u603b\u6210\u672c**\u53ca\u5176\u7ec6\u5206\u9879\u76ee\uff08\u5982\u8425\u4e1a\u6210\u672c\u3001\u5404\u9879\u8d39\u7528\uff09\u3002\n    *   \u5176\u4ed6\u6536\u76ca\u3001\u6295\u8d44\u6536\u76ca\u3001\u516c\u5141\u4ef7\u503c\u53d8\u52a8\u6536\u76ca\u7b49\u52a0\u9879\u4e0e\u51cf\u503c\u635f\u5931\u3002\n    *   \u6700\u7ec8\u8ba1\u7b97\u51fa**\u8425\u4e1a\u5229\u6da6\u3001\u5229\u6da6\u603b\u989d\u3001\u51c0\u5229\u6da6**\u3002\u5176\u4e2d\uff0c\u51c0\u5229\u6da6\u8fdb\u4e00\u6b65\u533a\u5206\u4e3a\u5f52\u5c5e\u4e8e\u6bcd\u516c\u53f8\u80a1\u4e1c\u7684\u51c0\u5229\u6da6\u548c\u5c11\u6570\u80a1\u4e1c\u635f\u76ca\u3002\n    *   **\u5176\u4ed6\u7efc\u5408\u6536\u76ca**\u53ca\u5176\u7a0e\u540e\u51c0\u989d\u3002\n    *   **\u7efc\u5408\u6536\u76ca\u603b\u989d**\u53ca\u5176\u5f52\u5c5e\u3002\n    *   **\u6bcf\u80a1\u6536\u76ca**\uff08\u57fa\u672c\u548c\u7a00\u91ca\uff09\u3002\n\n2.  **\u5408\u5e76\u73b0\u91d1\u6d41\u91cf\u8868\uff08\u5e74\u521d\u81f3\u62a5\u544a\u671f\u672b\uff09\u7684\u5f00\u59cb\u90e8\u5206**\uff1a\u6587\u6863\u5728\u5229\u6da6\u8868\u540e\u5f00\u59cb\u4e86\u73b0\u91d1\u6d41\u91cf\u8868\uff0c\u4ec5\u5217\u51fa\u4e86\u7b2c\u4e00\u9879\u201c\u7ecf\u8425\u6d3b\u52a8\u4ea7\u751f\u7684\u73b0\u91d1\u6d41\u91cf\u201d\u4e0b\u7684\u201c\u9500\u552e\u5546\u54c1\u3001\u63d0\u4f9b\u52b3\u52a1\u6536\u5230\u7684\u73b0\u91d1\u201d\u6570\u636e\uff0c\u540e\u7eed\u9879\u76ee\u672a\u5728\u63d0\u4f9b\u7684\u6587\u672c\u4e2d\u663e\u793a\u3002\n\n\u603b\u4f53\u800c\u8a00\uff0c\u8be5\u90e8\u5206\u6587\u6863\u7684\u6838\u5fc3\u662f\u5c55\u793a\u516c\u53f8\u5728\u62a5\u544a\u671f\u5185\u7684\u76c8\u5229\u80fd\u529b\uff08\u5229\u6da6\u8868\uff09\u548c\u7ecf\u8425\u6d3b\u52a8\u73b0\u91d1\u6d41\u5165\u7684\u8d77\u59cb\u4fe1\u606f\uff08\u73b0\u91d1\u6d41\u91cf\u8868\uff09\uff0c\u5e76\u63d0\u4f9b\u4e86\u4e0e\u4e0a\u5e74\u540c\u671f\u7684\u5bf9\u6bd4\u6570\u636e\u3002"
            },
            {
              "title": "\u5408\u5e76\u5e74\u521d\u5230\u62a5\u544a\u671f\u672b\u73b0\u91d1\u6d41\u91cf\u8868",
              "start_index": 9,
              "end_index": 11,
              "node_id": "0013",
              "summary": "\u8be5\u90e8\u5206\u6587\u6863\u662f\u7267\u539f\u98df\u54c1\u80a1\u4efd\u6709\u9650\u516c\u53f82025\u5e74\u7b2c\u4e09\u5b63\u5ea6\u62a5\u544a\u7684\u8d22\u52a1\u6570\u636e\u8282\u9009\uff0c\u4e3b\u8981\u6db5\u76d6\u4e86\u4e24\u4e2a\u6838\u5fc3\u90e8\u5206\uff1a\n\n1.  **\u5408\u5e76\u5229\u6da6\u8868\u53ca\u76f8\u5173\u6536\u76ca\u6570\u636e**\uff1a\u5c55\u793a\u4e86\u516c\u53f8\u622a\u81f3\u62a5\u544a\u671f\u672b\u7684\u76c8\u5229\u60c5\u51b5\u3002\u5173\u952e\u6570\u636e\u5305\u62ec\uff1a\n    *   \u51c0\u5229\u6da6\u4e3a151.12\u4ebf\u5143\uff0c\u8f83\u4e0a\u5e74\u540c\u671f\u7684112.46\u4ebf\u5143\u663e\u8457\u589e\u957f\u3002\n    *   \u5f52\u5c5e\u4e8e\u6bcd\u516c\u53f8\u80a1\u4e1c\u7684\u51c0\u5229\u6da6\u4e3a147.79\u4ebf\u5143\u3002\n    *   \u7efc\u5408\u6536\u76ca\u603b\u989d\u4e3a150.92\u4ebf\u5143\u3002\n    *   \u57fa\u672c\u6bcf\u80a1\u6536\u76ca\u4e3a2.74\u5143\uff0c\u7a00\u91ca\u6bcf\u80a1\u6536\u76ca\u4e3a2.69\u5143\u3002\n\n2.  **\u5408\u5e76\u73b0\u91d1\u6d41\u91cf\u8868\uff08\u5e74\u521d\u81f3\u62a5\u544a\u671f\u672b\uff09**\uff1a\u8be6\u7ec6\u5217\u62a5\u4e86\u516c\u53f8\u7ecf\u8425\u6d3b\u52a8\u3001\u6295\u8d44\u6d3b\u52a8\u548c\u7b79\u8d44\u6d3b\u52a8\u7684\u73b0\u91d1\u6d41\u5165\u4e0e\u6d41\u51fa\u60c5\u51b5\u3002\u4e3b\u8981\u8981\u70b9\u5305\u62ec\uff1a\n    *   \u7ecf\u8425\u6d3b\u52a8\u4ea7\u751f\u7684\u73b0\u91d1\u6d41\u91cf\u51c0\u989d\u4e3a285.80\u4ebf\u5143\uff0c\u73b0\u91d1\u6d41\u5165\u4e3b\u8981\u6765\u81ea\u9500\u552e\u5546\u54c1\u548c\u63d0\u4f9b\u52b3\u52a1\u3002\n    *   \u6295\u8d44\u6d3b\u52a8\u4ea7\u751f\u7684\u73b0\u91d1\u6d41\u91cf\u51c0\u989d\u4e3a-84.99\u4ebf\u5143\uff0c\u8868\u660e\u516c\u53f8\u4ecd\u5728\u8fdb\u884c\u8d44\u672c\u6027\u6295\u8d44\u3002\n    *   \u7b79\u8d44\u6d3b\u52a8\u4ea7\u751f\u7684\u73b0\u91d1\u6d41\u91cf\u51c0\u989d\u4e3a-156.56\u4ebf\u5143\uff0c\u4e3b\u8981\u7531\u4e8e\u507f\u8fd8\u503a\u52a1\u548c\u5206\u914d\u80a1\u5229\u652f\u4ed8\u7684\u73b0\u91d1\u5927\u4e8e\u7b79\u8d44\u6d41\u5165\u3002\n    *   \u6700\u7ec8\uff0c\u73b0\u91d1\u53ca\u73b0\u91d1\u7b49\u4ef7\u7269\u51c0\u589e\u52a044.24\u4ebf\u5143\uff0c\u671f\u672b\u4f59\u989d\u4e3a172.69\u4ebf\u5143\u3002\n\n\u6587\u6863\u672b\u5c3e\u6ce8\u660e\u672c\u5b63\u5ea6\u8d22\u52a1\u62a5\u544a\u672a\u7ecf\u5ba1\u8ba1\uff0c\u5e76\u7531\u516c\u53f8\u8463\u4e8b\u4f1a\u4e8e2025\u5e7410\u670831\u65e5\u53d1\u5e03\u3002"
            }
          ],
          "node_id": "0010",
          "summary": "\u8be5\u90e8\u5206\u6587\u6863\u8282\u9009\u81ea\u7267\u539f\u98df\u54c1\u80a1\u4efd\u6709\u9650\u516c\u53f82025\u5e74\u7b2c\u4e09\u5b63\u5ea6\u62a5\u544a\uff0c\u4e3b\u8981\u62ab\u9732\u4e86\u516c\u53f8\u524d\u5341\u5927\u80a1\u4e1c\u7684\u6301\u80a1\u60c5\u51b5\u53ca\u76f8\u5173\u8bf4\u660e\u3002\u5177\u4f53\u5185\u5bb9\u5305\u62ec\uff1a\u524d\u51e0\u540d\u673a\u6784\u80a1\u4e1c\uff08\u5982\u67cf\u745e\u3001\u4e2d\u4fe1\u5efa\u6295\u3001\u5de5\u884c\u3001\u5efa\u884c\u65d7\u4e0b\u591a\u53ea\u6307\u6570\u57fa\u91d1\uff09\u7684\u6301\u80a1\u6570\u91cf\u548c\u80a1\u4efd\u7c7b\u578b\uff1b\u5bf9\u516c\u53f8\u5b9e\u9645\u63a7\u5236\u4eba\uff08\u79e6\u82f1\u6797\u548c\u94b1\u745b\uff09\u53ca\u80a1\u4e1c\u95f4\u5173\u8054\u5173\u7cfb\u7684\u8bf4\u660e\uff1b\u5bf9\u80a1\u4e1c\u53c2\u4e0e\u878d\u8d44\u878d\u5238\u4e1a\u52a1\u60c5\u51b5\u7684\u8bf4\u660e\uff08\u4ee5\u5b59\u60e0\u521a\u4e3a\u4f8b\uff09\uff1b\u4ee5\u53ca\u5173\u4e8e\u516c\u53f8\u6b64\u524d\u4e24\u6b21\u80a1\u4efd\u56de\u8d2d\u8ba1\u5212\uff082023\u5e74\u548c2024\u5e74\u542f\u52a8\uff09\u7684\u5b9e\u65bd\u60c5\u51b5\u4e0e\u80a1\u4efd\u7528\u9014\u7684\u8be6\u7ec6\u6ce8\u91ca\u3002\u6587\u6863\u672b\u5c3e\u663e\u793a\uff0c\u672c\u8282\u4e0d\u6d89\u53ca\u8f6c\u878d\u901a\u4e1a\u52a1\u3001\u4f18\u5148\u80a1\u80a1\u4e1c\u60c5\u51b5\u6216\u5176\u4ed6\u91cd\u8981\u4e8b\u9879\uff0c\u5e76\u5373\u5c06\u5f00\u59cb\u5217\u793a\u5b63\u5ea6\u8d22\u52a1\u62a5\u8868\u3002"
        },
        {
          "title": "2025\u5e74\u8d77\u9996\u6b21\u6267\u884c\u65b0\u4f1a\u8ba1\u51c6\u5219\u8c03\u6574\u9996\u6b21\u6267\u884c\u5f53\u5e74\u5e74\u521d\u8d22\u52a1\u62a5\u8868\u76f8\u5173\u9879\u76ee\u60c5\u51b5",
          "start_index": 11,
          "end_index": 11,
          "node_id": "0014",
          "summary": "\u8be5\u90e8\u5206\u6587\u6863\u8282\u9009\u81ea\u7267\u539f\u98df\u54c1\u80a1\u4efd\u6709\u9650\u516c\u53f82025\u5e74\u7b2c\u4e09\u5b63\u5ea6\u62a5\u544a\uff0c\u4e3b\u8981\u6db5\u76d6\u4ee5\u4e0b\u5185\u5bb9\uff1a\n\n1.  **\u73b0\u91d1\u6d41\u91cf\u8868\u90e8\u5206\u6570\u636e**\uff1a\u5217\u793a\u4e86\u7b79\u8d44\u6d3b\u52a8\u76f8\u5173\u7684\u73b0\u91d1\u6d41\u51fa\u3001\u73b0\u91d1\u6d41\u91cf\u51c0\u989d\uff0c\u4ee5\u53ca\u73b0\u91d1\u53ca\u73b0\u91d1\u7b49\u4ef7\u7269\u7684\u51c0\u589e\u52a0\u989d\u3001\u671f\u521d\u4e0e\u671f\u672b\u4f59\u989d\u7b49\u5173\u952e\u8d22\u52a1\u6570\u636e\u3002\n2.  **\u62a5\u544a\u7b7e\u7f72\u4e0e\u58f0\u660e**\uff1a\u663e\u793a\u4e86\u62a5\u544a\u7531\u6cd5\u5b9a\u4ee3\u8868\u4eba\u3001\u4e3b\u7ba1\u4f1a\u8ba1\u5de5\u4f5c\u8d1f\u8d23\u4eba\u53ca\u4f1a\u8ba1\u673a\u6784\u8d1f\u8d23\u4eba\u7b7e\u7f72\uff0c\u5e76\u660e\u786e\u58f0\u660e\u516c\u53f8\u7b2c\u4e09\u5b63\u5ea6\u8d22\u52a1\u4f1a\u8ba1\u62a5\u544a\u672a\u7ecf\u5ba1\u8ba1\u3002\n3.  **\u65b0\u4f1a\u8ba1\u51c6\u5219\u6267\u884c\u60c5\u51b5**\uff1a\u8bf4\u660e\u516c\u53f82025\u5e74\u8d77\u4e0d\u9002\u7528\u56e0\u9996\u6b21\u6267\u884c\u65b0\u4f1a\u8ba1\u51c6\u5219\u800c\u8c03\u6574\u5e74\u521d\u8d22\u52a1\u62a5\u8868\u7684\u60c5\u51b5\u3002\n4.  **\u62a5\u544a\u57fa\u672c\u4fe1\u606f**\uff1a\u660e\u786e\u4e86\u62a5\u544a\u4e3b\u4f53\uff08\u7267\u539f\u98df\u54c1\u80a1\u4efd\u6709\u9650\u516c\u53f8\uff09\u3001\u62a5\u544a\u671f\u95f4\uff082025\u5e74\u7b2c\u4e09\u5b63\u5ea6\uff09\u4ee5\u53ca\u8463\u4e8b\u4f1a\u6279\u51c6\u62a5\u544a\u7684\u65e5\u671f\uff082025\u5e7410\u670831\u65e5\uff09\u3002"
        },
        {
